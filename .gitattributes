# Normalize line endings and diff behavior across platforms.
* text=auto

# Source files — always LF
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Editorconfig-style: lock CRLF on Windows shell artifacts if any
*.bat text eol=crlf

# Binary / images
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.svg -text

# GitHub language statistics: exclude vendored/generated
eslint.config.js linguist-language=JavaScript
jsconfig.json linguist-language=JSON